# ─── Tobacco ERP API — environment ──────────────────────────────────────────────
# Copy to apps/api/.env  (or run: pnpm --filter @tobacco/api env:init  — it generates the JWT secret for you).
# .env is git-ignored. NEVER commit it and NEVER paste these values into chat.

NODE_ENV=development
PORT=4000

# Neon PostgreSQL (create a project, then a `dev` branch and a `test` branch).
# Neon console → Connect → choose the branch → copy BOTH strings:
#   DATABASE_URL = the POOLED connection string (host contains "-pooler") — used by the running API
#   DIRECT_URL   = the DIRECT connection string — used by `prisma migrate`
DATABASE_URL="postgresql://neondb_owner:npg_wpVI3cuKCgt2@ep-dark-paper-behazzmv-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:npg_wpVI3cuKCgt2@ep-dark-paper-behazzmv-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Integration tests run against a SEPARATE Neon branch (they reset its data!). Direct string of the `test` branch.
TEST_DATABASE_URL="postgresql://neondb_owner:npg_wpVI3cuKCgt2@ep-dark-paper-behazzmv-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Auth
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Web app (CORS + links in emails)
WEB_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Documents (uploaded invoices, Flow Disks, generated PDFs). "blob" (production) is not implemented yet.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage

# Mail: "outbox" stores messages in the database (no real email is sent) — read them at GET /api/v1/staff/dev-mailbox.
MAIL_DRIVER=outbox
MAIL_FROM="Tobacco ERP <no-reply@localhost>"

SWAGGER_ENABLED=true

# Demo accounts (development only): seeded by `pnpm --filter @tobacco/api db:seed`
DEMO_MODE=true
SEED_PASSWORD=Demo-Tobacco-2026
