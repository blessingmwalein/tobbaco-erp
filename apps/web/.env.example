# Buyer Portal API (NestJS). Local default shown. On Vercel set this to the deployed API URL, e.g. https://<api-project>.vercel.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Show the "demo accounts" hint on the buyer sign-in page. Set to "false" for production.
NEXT_PUBLIC_DEMO_MODE=true
